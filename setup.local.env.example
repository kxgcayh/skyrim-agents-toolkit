# Copy to setup.local.env (gitignored) and fill in the paths setup.sh cannot detect, e.g. a CrossOver/Wine
# install on macOS. KEY=VALUE per line, read as data. A variable already set in the environment wins.
# SKYRIM_GAME_DIR='/path/to/Skyrim Special Edition'
# SKYRIM_CONFIG_DIR='/path/to/My Games/Skyrim Special Edition'
# SKYRIM_LOADORDER_DIR='/path/to/MO2/profiles/<profile>'
# SKYRIM_MO2_MODS='/path/to/MO2/mods'
# SKYRIM_MO2_OVERWRITE='/path/to/MO2/overwrite'
